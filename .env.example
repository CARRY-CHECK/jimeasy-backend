# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다(.gitignore에 포함).
# 프로세스 환경변수가 .env보다 우선한다.

# 질의 구조화·판정·대화 도구 선택에 쓰는 OpenAI API 키 (필수, 단위 테스트에는 필요 없음)
OPENAI_API_KEY=

# 선택: 모델 설정 파일. 비우면 config/model.json(임베딩 CPU)을 쓴다.
# Apple Silicon에서 MPS로 임베딩하려면 config/mac_model.json을 지정한다.
# CARRY_CHECK_MODEL_CONFIG=config/mac_model.json

# 선택: LangSmith 추적. 켜면 질문과 검색 문서가 LangSmith로 전송된다.
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=
